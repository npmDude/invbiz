# Test-only environment. Safe to commit: the JWT key signs throwaway
# tokens for the Testcontainers database and must never be used outside
# tests. DATABASE_URL is intentionally absent — it is injected per run by
# test/global-setup.ts (see test/setup.ts).
NODE_ENV=test
DATABASE_SSL=false
JWT_SECRET=invbiz-integration-test-secret-32bytes!
